<Page x:Class="Source.View.Pages.EditUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditUser"
      Loaded="Page_Loaded">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <StackPanel VerticalAlignment="Center"                       
                    HorizontalAlignment="Center"                        
                    MinWidth="200">

            <Label Content="Логин"/>
            <TextBox x:Name="tbLogin" Margin="5, 0, 5, 5"/>

            <Label Content="Пароль"/>
            <PasswordBox x:Name="pbPassword" Margin="5, 0, 5, 5"/>

            <Label Content="Почта"/>
            <TextBox x:Name="tbMail" Margin="5, 0, 5, 5"/>

            <CheckBox Content="Тёмная тема" x:Name="cbDarkTheme" Margin="5"/>
            
            <DockPanel>
                <Button x:Name="bEdit"                            
                        Height="30" Width="180"                           
                        Content="Редактировать"                            
                        HorizontalAlignment="Center"                          
                        Margin="0, 5, 5, 0"                            
                        Background="LawnGreen"                          
                        Click="bEdit_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Page>
