<Page x:Class="Source.View.Pages.ValidationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ValidationPage">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="4">
                    <Button x:Name="bSelectXML"
                            Content="Выбрать xml"
                            Click="bSelectXML_Click"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Выбранный xml: "/>
                        <TextBlock x:Name="tbSelectedXML"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="4">
                    <Button x:Name="bSelectXSD"
                            Content="Выбрать xsd"
                            Click="bSelectXSD_Click"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Выбранный xsd: "/>
                        <TextBlock x:Name="tbSelectedXSD"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <Button x:Name="bDoValidation"
                    Click="bDoValidation_Click"
                    Content="Проверить"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Результат: "/>
                <TextBlock x:Name="tbResult"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
