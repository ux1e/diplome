<Page x:Class="Source.View.Pages.AddNewUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddNewUser">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <StackPanel VerticalAlignment="Center"                       
                    HorizontalAlignment="Center"                        
                    MinWidth="200">

            <Label Content="Логин"/>
            <TextBox x:Name="tbLogin" Margin="5, 0, 5, 5"/>

            <Label Content="Пароль" ToolTip="Можно оставить пустым, тогда пароль сгенерируется сам"/>
            <PasswordBox x:Name="pbPassword" Margin="5, 0, 5, 5"
                             ToolTip="Можно оставить пустым, тогда пароль сгенерируется сам"/>

            <CheckBox Content="Сгенерировать пароль" x:Name="cbGeneratePassword" Margin="5" Click="cbGeneratePassword_Checked"/>

            <Label Content="Почта" ToolTip="Можно оставить пустым"/>
            <TextBox x:Name="tbMail" Margin="5, 0, 5, 5" ToolTip="Можно оставить пустым"/>

            <DockPanel>
                <Button x:Name="bCreate"                            
                        Height="30" Width="180"                           
                        Content="Создать"                            
                        HorizontalAlignment="Center"                          
                        Margin="0, 5, 5, 0"                            
                        Background="LawnGreen"                          
                        Click="bCreate_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Page>
