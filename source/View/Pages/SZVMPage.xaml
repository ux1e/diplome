<Page x:Class="Source.View.Pages.SZVMPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Source.View.Pages"
      xmlns:local_convert="clr-namespace:Source.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SZVMPage"
      Loaded="Page_Loaded">

    <Page.Resources>
        <local_convert:BoolConverter x:Key="BoolConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <StackPanel Background="#f2bd38" 
                    Margin="5" 
                    Grid.Row="0" Grid.Column="0" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch">
            <Label Content="Страхователь: " VerticalAlignment="Center"/>
            <Label Content="[123-456-789000]" x:Name="lINN" VerticalAlignment="Center"/>
            <Label Content="TEST" x:Name="lName" VerticalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="bInsurer"                                           
                Grid.Column="1" Grid.Row="0"                                          
                Content="Сменить"                       
                Click="bChangeInsurer"/>

        <DockPanel Grid.Row="1" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="SZVMGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="False"                      
                          CanUserReorderColumns="False" CanUserSortColumns="False" IsReadOnly="True" FontSize="10"                             
                          Grid.Row="0" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Год" Binding="{Binding Path=Year}" Width="*" />
                        <DataGridTextColumn Header="Месяц" Binding="{Binding Path=Month}" Width="*" />
                        <DataGridTextColumn Header="Количество сотрудников" Binding="{Binding Path=WorkersCount}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="WorkerGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="False"                               
                          CanUserReorderColumns="False" CanUserSortColumns="False" IsReadOnly="True" FontSize="10"                             
                          ItemsSource = "{Binding ElementName=SZVMGrid, Path=SelectedItem.FormsSZV_M_Stuff}"                             
                          Grid.Row="1" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ФИО" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1} {2}">
                                                <Binding Path="Worker.FirstName"/>
                                                <Binding Path="Worker.LastName"/>
                                                <Binding Path="Worker.MiddleName"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ИНН" Binding="{Binding Path=Worker.INN}" Width="*" />
                        <DataGridTextColumn Header="Уволен" Binding="{Binding Path=Worker.IsFired, Converter={StaticResource BoolConverter}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="bAddSZVM" 
                                Grid.Row="0"
                                Content="Добавить" 
                                Click="bAddSZVM_Click"/>

                        <Button x:Name="bRemoveSZVM" 
                                Grid.Row="1"
                                Content="Удалить" 
                                Click="bRemoveSZVM_Click"/>

                    </Grid>
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="bShowUsers" 
                                Grid.Row="0"
                                Content="Добавить" 
                                Click="bShowUsers_Click"/>

                        <Button x:Name="bDeleteUsers" 
                                Grid.Row="1"
                                Content="Удалить" 
                                Click="bDeleteUsers_Click"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button x:Name="bMakeReport" 
                        Click="bMakeReport_Click"
                        Margin="2"
                        Grid.Column="0"                                        
                        Content="Создать XML"/>

                <Button x:Name="bOpenFolder" 
                        Click="bOpenFolder_Click"
                        Margin="2"
                        Grid.Column="1"       
                        FontSize="12"
                        Content="Открыть папку"/>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
