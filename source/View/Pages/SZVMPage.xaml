<Page x:Class="Source.View.Pages.SZVMPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SZVMPage"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <StackPanel Background="#f2bd38" 
                    Margin="0, 5" 
                    Grid.Row="0" Grid.Column="0" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch">
            <Label Content="Страхователь: "/>
            <Label Content="[123-456-789000]" x:Name="lINN"/>
            <Label Content="TEST" x:Name="lName"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="bGoBack" 
                    Click="bGoBack_Click" 
                    Width="150"                                       
                    Content="&lt;&lt; Назад" 
                    Style="{DynamicResource CustomButtonStyle}"/>

            <Button x:Name="bMakeReport" 
                    Click="bMakeReport_Click" 
                    Width="150"                                        
                    Content="Создать XML" 
                    Style="{DynamicResource CustomButtonStyle}"/>
        </StackPanel>
    </Grid>
</Page>
