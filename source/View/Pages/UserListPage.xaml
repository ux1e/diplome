<Page x:Class="Source.View.Pages.UserListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Source.View.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserListPage"
      Loaded="Page_Loaded">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Найти: " FontSize="16"/>
            <TextBox Width="300" x:Name="tbSearch" TextChanged="tbSearch_TextChanged"/>
        </StackPanel>

        <ListView x:Name="lvUsers" Grid.Row="1" Grid.Column="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Label Content="{Binding Id}" ContentStringFormat="ID: {0}"/>
                        <Label Content="{Binding Name}" ContentStringFormat="Логин: {0}"/>
                        <Label Content="{Binding Password}" ContentStringFormat="Пароль: {0}"/>
                        <Label Content="{Binding Mail}" ContentStringFormat="Почта: {0}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <DockPanel Grid.Row="2" Grid.Column="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button x:Name="bMakeNewUser" 
                        Click="bMakeNewUser_Click" 
                        Margin="2"
                        Grid.Column="0"                                       
                        Content="Создать"/>

                <Button x:Name="bEditUser" 
                        Click="bEditUser_Click" 
                        Margin="2"
                        Grid.Column="1"                                       
                        Content="Изменить"/>

                <Button x:Name="bDeleteUser" 
                        Click="bDeleteUser_Click" 
                        Margin="2"
                        Grid.Column="2"                                        
                        Content="Удалить"/>
            </Grid>
        </DockPanel>

