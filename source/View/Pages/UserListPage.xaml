<Page x:Class="Source.View.Pages.UserListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserListPage">

    <Grid Style="{DynamicResource BackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="FuncPanel" Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="False" 
                      CanUserReorderColumns="False" CanUserSortColumns="False" IsReadOnly="True" FontSize="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Path=Id}" Width="*" />
                    <DataGridTextColumn Header="Имя" Binding="{Binding Path=Name}" Width="*" />
                    <DataGridTextColumn Header="Почта" Binding="{Binding Path=Mail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="bGoBack" 
                    Click="bGoBack_Click" 
                    Width="150"                                       
                    Content="&lt;&lt; Назад" 
                    Style="{DynamicResource CustomButtonStyle}"/>

            <Button x:Name="bMakeNewUser" 
                    Click="bMakeNewUser_Click" 
                    Width="150"                                        
                    Content="Создать" 
                    Style="{DynamicResource CustomButtonStyle}"/>

            <Button x:Name="bEditUser" 
                    Click="bEditUser_Click"
                    Width="150"                                        
                    Content="Изменить" 
                    Style="{DynamicResource CustomButtonStyle}"/>

            <Button x:Name="bDeleteUser" 
                    Click="bDeleteUser_Click" 
                    Width="150"                                        
                    Content="Удалить" 
                    Style="{DynamicResource CustomButtonStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Имя" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="NameTextBox" Width="85" Height="35" Margin="5,0,0,0" Style="{DynamicResource CustomTextBoxStyle}"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Почта" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="MailTextBox" Width="85" Height="35" Margin="5,0,0,0" Style="{DynamicResource CustomTextBoxStyle}"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="AddCommit"
                    Background="#a1b281" BorderBrush="#a1b281"                                  
                    Content="Добавить"                                 
                    Width="70" Height="35" 
                    Margin="5"
                    Click="AddCommit_Click">
                </Button>

                <Button x:Name="AddRollback"
                    Background="#fbceb1" BorderBrush="#fbceb1"                                  
                    Content="Отменить"                                 
                    Width="70" Height="35" 
                    Margin="5" 
                    Click="AddRollback_Click">
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
