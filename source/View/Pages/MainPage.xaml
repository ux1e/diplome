<Page x:Class="source.View.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.35*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Label Content="Отчёты" 
                       Grid.Column="0" Grid.Row="0"
                       Style="{StaticResource CustomLabelStyle}"/>

            <Button x:Name="bMakeReport" 
                        Grid.Column="0" Grid.Row="1"
                        Content="Создать отчёт"
                        Click="bMakeReport_Click"
                        Style="{StaticResource CustomButtonStyle}"/>

            <Label Content="Импорт\Экспорт" 
                       Grid.Column="1" Grid.Row="0"
                       Style="{StaticResource CustomLabelStyle}"/>

            <Button x:Name="bImport"
                        Grid.Column="1" Grid.Row="1"
                        Content="Импорт"
                        Style="{StaticResource CustomButtonStyle}"/>

            <Button x:Name="bExport"
                        Grid.Column="1" Grid.Row="2"
                        Content="Экспорт"
                        Style="{StaticResource CustomButtonStyle}"/>

            <Label Content="Настройки" 
                       Grid.Column="2" Grid.Row="0"
                       Style="{StaticResource CustomLabelStyle}"/>

            <Button x:Name="bSettings"
                        Grid.Column="2" Grid.Row="1"
                        Content="Настройки"
                        Style="{StaticResource CustomButtonStyle}"
                        Click="bSettings_Click"/>

            <Button x:Name="bUserList"
                        Grid.Column="2" Grid.Row="2"
                        Content="Создать пользователя"
                        Style="{StaticResource CustomButtonStyle}"/>
        </Grid>
    </Grid>
</Page>
