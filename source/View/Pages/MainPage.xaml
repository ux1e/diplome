<Page x:Class="source.View.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Label Content="Отчёты"                                         
               Grid.Column="0" Grid.Row="0"                                        
               Style="{DynamicResource CustomLabelStyle}"/>

        <Button x:Name="bSZVM"                
                Grid.Column="0" Grid.Row="1"                
                Content="СЗВ-М"                 
                Click="bSZVM_Click"                
                Style="{DynamicResource CustomButtonStyle}"                   
                ToolTip="Сведения о застрахованных лицах"/>

        <Button x:Name="bSZVTD"                     
                Grid.Column="0" Grid.Row="2"                   
                Content="СЗВ-ТД"                    
                Click="bSZVTD_Click"                   
                Style="{DynamicResource CustomButtonStyle}"                   
                ToolTip="Сведения о трудовой деятельности работников"/>

        <Label Content="Настройки"                                          
               Grid.Column="1" Grid.Row="0"                                       
               Style="{DynamicResource CustomLabelStyle}"/>

        <Button x:Name="bSettings"                                            
                Grid.Column="1" Grid.Row="1"                                           
                Content="Настройки"                                            
                Style="{DynamicResource CustomButtonStyle}"                                          
                Click="bSettings_Click"/>

        <Button x:Name="bUserList"                                           
                Grid.Column="1" Grid.Row="2"                                          
                Content="Управление пользователями"                                        
                Style="{DynamicResource CustomButtonStyle}"                   
                Click="bUserList_Click"/>
    </Grid>
</Page>
