<Page x:Class="Source.View.Pages.InsurersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InsurersPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="FuncPanel" Width="0.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="Grid" Grid.Row="0" Grid.Column="0">
            
        </DataGrid>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="bGoBack" 
                    Click="bGoBack_Click" 
                    Width="150"                                       
                    Content="&lt;&lt; Назад" 
                    Style="{DynamicResource CustomButtonStyle}"/>

            <Button x:Name="bSelectInsurer" 
                    Click="bSelectInsurer_Click" 
                    Width="150"                                        
                    Content="Выбрать" 
                    Style="{DynamicResource CustomButtonStyle}"/>
            
            <Button x:Name="bMakeNewInsurer" 
                    Click="bMakeNewInsurer_Click" 
                    Width="150"                                        
                    Content="Создать" 
                    Style="{DynamicResource CustomButtonStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Name" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="NameTextBox" Width="85" Height="35" Margin="5,0,0,0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="NameShort" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="NameShortTextBox" Width="85" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="LastName" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="LastNameTextBox" Width="85" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="FirstName" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="FirstNameTextBox" Width="85" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="MiddleName" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="MiddleNameTextBox" Width="85" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="InsuranceNumber" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="InsuranceNumberTextBox" Width="85" Height="35" Margin="5,0,0,0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="INN" Margin="5,0,0,0" Width="100" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="INNTextBox" Width="85" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="AddCommit"
                    Background="#a1b281" BorderBrush="#a1b281"                                  
                    Content="Добавить"                                 
                    Width="70" Height="35" 
                    Margin="5"
                    Click="AddCommit_Click">
                </Button>

                <Button x:Name="AddRollback"
                    Background="#fbceb1" BorderBrush="#fbceb1"                                  
                    Content="Отменить"                                 
                    Width="70" Height="35" 
                    Margin="5" 
                    Click="AddRollback_Click">
                </Button>
            </StackPanel>
            
        </StackPanel>

    </Grid>
</Page>
