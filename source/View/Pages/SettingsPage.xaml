<Page x:Class="source.View.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:source.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage">

    <Grid>
        <StackPanel>
            <Label Content="SettingPage" Style="{DynamicResource CustomLabelStyle}"/>
            <Button Width="200" Height="100" Content="Go Back" x:Name="bGoBack" Click="bGoBack_Click" Style="{DynamicResource CustomButtonStyle}"/>
            <Button Width="200" Height="100" Content="Change Theme" x:Name="bChangeTheme" Click="bChangeTheme_Click" Style="{DynamicResource CustomButtonStyle}"/>
        </StackPanel>
    </Grid>
</Page>
