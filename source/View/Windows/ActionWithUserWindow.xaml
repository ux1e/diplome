<Window x:Class="Source.View.Windows.ActionWithUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Source.View.Windows"
        mc:Ignorable="d"
        Title="Действия с пользователем" 
        Height="450" MinHeight="450"
        Width="450" MinWidth="450"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent" 
        MouseLeftButtonDown="Window_Drag"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border CornerRadius="6" Background="{DynamicResource MaterialDesignPaper}" 
            BorderBrush="Black" BorderThickness="0.25">
        <Grid>
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MinWidth="200">

                <Label Content="Логин"/>
                <TextBox x:Name="tbLogin" Margin="5, 0, 5, 5"/>

                <Label Content="Пароль" ToolTip="Можно оставить пустым, тогда пароль сгенерируется сам"/>
                <PasswordBox x:Name="pbPassword" Margin="5, 0, 5, 5"
                             ToolTip="Можно оставить пустым, тогда пароль сгенерируется сам"/>

                <Label Content="Почта" ToolTip="Можно оставить пустым"/>
                <TextBox x:Name="tbMail" Margin="5, 0, 5, 5" ToolTip="Можно оставить пустым"/>

                <DockPanel>
                    <Button x:Name="bCancel" 
                            Height="30" Width="90"
                            Content="Отмена" 
                            HorizontalAlignment="Left" 
                            Margin="5, 5, 0, 0"
                            Background="Red"
                            Click="bCancel_Click"/>

                    <Button x:Name="bCreate"
                            Height="30" Width="90"
                            Content="Создать" 
                            HorizontalAlignment="Right"
                            Margin="0, 5, 5, 0" 
                            Background="LawnGreen"
                            Click="bCreate_Click"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
