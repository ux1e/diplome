<Window x:Class="source.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:source"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="450" MinHeight="450"
        Width="800" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*" MinHeight="45"/>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="0.1*" MinHeight="45"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="1" Background="AliceBlue">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.35*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Label Content="Отчёты" 
                       Grid.Column="0" Grid.Row="0"
                       Style="{StaticResource CustomLabelStyle}"/>

                <Button x:Name="bMakeReport" 
                        Grid.Column="0" Grid.Row="1"
                        Content="Создать отчёт"
                        Click="bMakeReport_Click"
                        Style="{StaticResource CustomButtonStyle}"/>

                <Label Content="Импорт\Экспорт" 
                       Grid.Column="1" Grid.Row="0"
                       Style="{StaticResource CustomLabelStyle}"/>
                
                <Button x:Name="bImport"
                        Grid.Column="1" Grid.Row="1"
                        Content="Импорт"
                        Style="{StaticResource CustomButtonStyle}"/>
                
                <Button x:Name="bExport"
                        Grid.Column="1" Grid.Row="2"
                        Content="Экспорт"
                        Style="{StaticResource CustomButtonStyle}"/>

                <Label Content="Настройки" 
                       Grid.Column="2" Grid.Row="0"
                       Style="{StaticResource CustomLabelStyle}"/>
                
                <Button x:Name="bSettings"
                        Grid.Column="2" Grid.Row="1"
                        Content="Настройки"
                        Style="{StaticResource CustomButtonStyle}"/>

                <Button x:Name="bUserList"
                        Grid.Column="2" Grid.Row="2"
                        Content="Создать пользователя"
                        Style="{StaticResource CustomButtonStyle}"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
