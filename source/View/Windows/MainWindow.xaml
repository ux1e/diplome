<Window x:Class="source.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:source"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="450" MinHeight="450"
        Width="800" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*" MinHeight="45"/>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="0.1*" MinHeight="45"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="1" Background="AliceBlue">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Отчёты" Foreground="Gray" FontFamily="AppleSDGothicNeo-Regular" FontSize="20" Margin="5,5,5,15"/>

                    <Button x:Name="bMakeReport"
                        Height="100" 
                        Margin="5"
                        Content="Создать отчёт"
                        Click="bMakeReport_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Импорт\Экспорт" Foreground="Gray" FontFamily="AppleSDGothicNeo-Regular" FontSize="20" Margin="5,5,5,15"/>

                    <Button Height="100" Margin="5" Content="Импорт"/>
                    <Button Height="100" Margin="5" Content="Экспорт"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Настройки" Foreground="Gray" FontFamily="AppleSDGothicNeo-Regular" FontSize="20" Margin="5,5,5,15"/>

                    <Button Height="100" Margin="5" Content="Настройки"/>
                    <Button Height="100" Margin="5" Content="Создать пользователя"/>
                </StackPanel>
            </Grid>
        </DockPanel>

    </Grid>
</Window>
