<Window x:Class="Source.View.Windows.TestMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Source.View.Windows"
        mc:Ignorable="d"
        Title="TestMainWindow" 
        Height="450" MinHeight="450"
        Width="800" MinWidth="800"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent" 
        MouseLeftButtonDown="Window_Drag"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border CornerRadius="6" Background="{DynamicResource MaterialDesignPaper}" 
            BorderBrush="Transparent" BorderThickness="0.25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="250*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.05*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.15*"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                            ToolTip="Сменить тему"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Width="12" Height="12" 
                            Grid.Column="0" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Click="ToggleTheme">
                        <materialDesign:PackIcon
                                Kind="ThemeLightDark"
                                Height="10"
                                Width="10" />
                    </Button>

                    <DockPanel Grid.Column="2">
                        <Button Background="#FFDECF34"
                                BorderBrush="#FFDECF34"
                                Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                ToolTip="Minimize"
                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                Width="12" Height="12" Margin="10,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center" 
                                Click="MinimizeApp">
                            <materialDesign:PackIcon             
                                Kind="minus"      
                                Height="10"
                                Width="10" />
                        </Button>
                        <Button Background="Red"
                                BorderBrush="Red"
                                Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                ToolTip="Close"
                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                Width="12" Height="12" Margin="10,0,0,0"                           
                                HorizontalAlignment="Left" VerticalAlignment="Center" 
                                Click="CloseApp">
                            <materialDesign:PackIcon
                                Kind="WindowClose"
                                Height="10"
                                Width="10" />
                        </Button>
                    </DockPanel>

                    <TextBlock x:Name="tbUserWelcome" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" 
                               Grid.Column="1" 
                               Text="Добро пожаловать, "/>
                </Grid>
            </DockPanel>

            <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                <RadioButton
                    x:Name="rbSZVM"
                    Style="{StaticResource MaterialDesignTabRadioButton}"
                    BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                    IsChecked="False"
                    Checked="TabChanged">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ReceiptText" />
                        <TextBlock
                            Margin="4 0 0 0"
                            Text="СЗВ-М" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="rbSZVTD"
                    Style="{StaticResource MaterialDesignTabRadioButton}"
                    BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                    IsChecked="False"
                    Checked="TabChanged">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ReceiptText" />
                        <TextBlock
                            Margin="4 0 0 0"
                            Text="СЗВ-ТД" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="rbValidation"
                    Style="{StaticResource MaterialDesignTabRadioButton}"
                    BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                    IsChecked="False"
                    Checked="TabChanged">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PipeWrench" />
                        <TextBlock
                            Margin="4 0 0 0"
                            Text="Валидация" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="rbUsers"
                    Style="{StaticResource MaterialDesignTabRadioButton}"
                    BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                    IsChecked="False"
                    Checked="TabChanged">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Account" />
                        <TextBlock
                            Margin="4 0 0 0"
                            Text="Пользователи" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <Frame x:Name="RootFrame" 
                   Grid.Column="1" Grid.Row="1" 
                   Margin="5"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Border>
</Window>
