<Window x:Class="Source.View.Windows.WorkerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Source.View.Windows"
        mc:Ignorable="d"
        Title="WorkerInfoWindow" Height="500" Width="350">
    <Grid Style="{DynamicResource BackgroundColor}">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Страховой номер" Margin="5,0,0,0" Width="125" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="InsurerNumberTextBox" Width="175" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="ИНН" Margin="5,0,0,0" Width="125" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="INNTextBox" Width="175" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Фамилия" Margin="5,0,0,0" Width="125" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="LastNameTextBox" Width="175" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Имя" Margin="5,0,0,0" Width="125" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="FirstNameTextBox" Width="175" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Отчество" Margin="5,0,0,0" Width="125" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <TextBox x:Name="MiddleNameTextBox" Width="175" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Пол" Margin="5,0,0,0" Width="125" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <ComboBox x:Name="SexComboBox" Width="175" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Профессия" Margin="5,0,0,0" Width="125" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <ComboBox x:Name="ProfessionComboBox" Width="175" Height="35" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Дата рождения" Margin="5,0,0,0" Width="125" Style="{DynamicResource CustomLabelStyleSmall}"/>
                <DatePicker x:Name="BirthDatePicker" Width="175" Height="35" Margin="5,0,0,0" SelectedDateFormat="Short" />
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
