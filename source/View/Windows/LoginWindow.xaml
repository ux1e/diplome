<Window x:Class="source.View.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:source.View.Windows"
        mc:Ignorable="d"
        Title="Авторизация" 
        Height="220" MinHeight="220"
        Width="320" MinWidth="320"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel 
            VerticalAlignment="Center" 
            HorizontalAlignment="Center"
            MinWidth="200">

            <Label Content="Логин"/>
            <TextBox x:Name="tbLogin" Margin="5, 0, 5, 5"/>

            <Label Content="Пароль"/>
            <PasswordBox x:Name="pbPassword" Margin="5, 0, 5, 5"/>

            <DockPanel>
                <Button x:Name="bExit" 
                        Height="30" Width="90"
                        Content="Выйти" 
                        HorizontalAlignment="Left" 
                        Margin="5, 5, 0, 0"
                        Background="Red"
                        Click="bExit_Click"/>

                <Button x:Name="bSignIn"
                        Height="30" Width="90"
                        Content="Войти" 
                        HorizontalAlignment="Right"
                        Margin="0, 5, 5, 0" 
                        Background="LawnGreen"
                        Click="bSignIn_Click"/>
            </DockPanel>

        </StackPanel>
    </Grid>
</Window>
